from PIL import Image
import matplotlib.pyplot as plt

image = Image.open("image.avif")

gray_image = image.convert("L")

plt.subplot(1, 2, 1)
plt.imshow(image)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(gray_image, cmap="gray")
plt.title("Grayscale Image")
plt.axis("off")

plt.show()
